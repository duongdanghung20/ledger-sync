# Copy to .env and adjust. docker compose reads this file for interpolation and
# the backend loads it too. Nothing secret should be committed — .env is ignored.

# ── Skeleton (ticket 01) ────────────────────────────────────────────────────
# Public origin the whole app is served at (frontend + API, one origin, via the
# reverse proxy). Later flows (e.g. the QuickBooks OAuth callback) build URLs
# from this. Must match how you reach the proxy.
APP_BASE_URL=http://localhost:8080

# Host port the reverse proxy publishes (container listens on 80). Keep in sync
# with APP_BASE_URL's port.
PROXY_PORT=8080

# PostgreSQL. POSTGRES_* configure the db container; DATABASE_URL is how the
# backend (raw psycopg 3) and Alembic connect. Keep them consistent.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
DATABASE_URL=postgresql://ledger:ledger@db:5432/ledger

# ── Auth (ticket 02) ─────────────────────────────────────────────────────────
# Email of the first Admin, created on first empty boot; a single-use set-password
# link is printed to the container logs. Required to bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Organization name. Optional; defaults to "Ledger-Sync" if unset.
ORG_NAME=Ledger-Sync
# HMAC key that signs the session cookie. Required for login/session validation;
# no default by design — generate a long random value (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-value

# ── QuickBooks (tickets 04/05) ───────────────────────────────────────────────
# QuickBooks Online app credentials from the Intuit developer portal. Live only
# in the environment — never persisted to the database or shown in the UI.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Fernet key encrypting the QBO refresh token at rest; kept OUT of the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# ── Added by later tickets ──────────────────────────────────────────────────
# Feature agents do NOT edit this file; they report their variables to the
# coordinator, who appends them here. Read them in code via app.config.env(...).
